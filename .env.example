# Supabase Configuration
# Create a Supabase project at https://supabase.com and copy your credentials here

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Email Service Configuration
# Create a Resend account at https://resend.com and copy your API key here
# VITE_RESEND_API_KEY=your_resend_api_key

# Optional: App URL for email links (defaults to https://marjahans.com)
# VITE_APP_URL=https://yourdomain.com

# Stripe Configuration
# Create a Stripe account at https://stripe.com and copy your keys here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Optional: Gemini API Key for AI features (if applicable)
# GEMINI_API_KEY=your_gemini_api_key
