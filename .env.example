# Environment Configuration Template
# Copy this file to .env.local and fill in your actual credentials

# ============================================================================
# SUPABASE (Required)
# ============================================================================
# Create a project at https://supabase.com
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================================================
# PAYMENTS
# ============================================================================
# Stripe (https://stripe.com)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Server-side only (deploy to Supabase Edge Functions via secrets)
# NEVER expose these in client-side code:
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================================================
# EMAIL (Optional)
# ============================================================================
# Resend (https://resend.com) - for order confirmations
# Deploy to Edge Functions, do not use client-side
# VITE_RESEND_API_KEY=your_resend_api_key

# ============================================================================
# OTHER OPTIONAL SERVICES
# ============================================================================
# App URL for email links (defaults to https://marjahans.com)
# VITE_APP_URL=https://yourdomain.com

# Gemini API for AI features (use server-side proxy in production)
# VITE_GEMINI_API_KEY=your_gemini_api_key

# Typesense for search (if self-hosting)
# VITE_TYPESENSE_HOST=localhost
# VITE_TYPESENSE_PORT=8108
# VITE_TYPESENSE_PROTOCOL=http
# VITE_TYPESENSE_API_KEY=xyz

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================
# Admin password (dev environment only - use Supabase Auth in production)
# VITE_ADMIN_PASSWORD=dev_password_change_me

# Mock API server (local development)
# VITE_API_BASE_URL=http://localhost:3000

# ============================================================================
# SECURITY REMINDER
# ============================================================================
# NEVER commit real secrets to version control
# Use platform secret managers in production:
# - Vercel: Environment Variables
# - Netlify: Environment Variables
# - Supabase: Edge Function Secrets (npx supabase secrets set KEY=value)
